{
  "name": "media-playlist-system",
  "version": "1.0.0",
  "description": "A Node.js application for managing and playing media playlists",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server/index.ts",
    "start": "node dist/server/index.js",
    "test": "jest",
    "clean": "rimraf dist",
    "db:init": "ts-node src/server/database/cli.ts init",
    "db:reset": "ts-node src/server/database/cli.ts reset",
    "db:seed": "ts-node src/server/database/cli.ts seed",
    "db:clear": "ts-node src/server/database/cli.ts clear",
    "db:reset-and-seed": "ts-node src/server/database/cli.ts reset-and-seed"
  },
  "keywords": [
    "media",
    "playlist",
    "nodejs",
    "websocket"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.7.4",
    "sqlite3": "^5.1.6",
    "ts-node": "^10.9.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.3",
    "jest": "^29.7.0",
    "rimraf": "^5.0.5",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.3",
    "ts-jest": "^29.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
