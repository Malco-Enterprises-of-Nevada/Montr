# Force HTTP/1.1 on the listener. Cloudflare speaks HTTP/2 or HTTP/3 to
# origins by default, and when the client upgrades a WebSocket, CF has to
# translate into RFC 8441 "CONNECT :protocol=websocket" for the origin.
# That path has flaky interop: we observed the Pi's /ws connection being
# torn down ~300 ms after registration with code 1006 on both sides, and
# caddy logging `writing: http2: stream closed` mid-proxy. Forcing h1
# removes the translation and makes WS behave like a plain HTTP/1.1
# Upgrade all the way through. Regular HTTP requests are a touch slower
# without h2 multiplexing but still well under CF's 100 s budget.
{
	servers {
		protocols h1
	}
}

montr.budgetvegas.com {
	# Self-signed internal cert. Cloudflare is the public-facing TLS
	# endpoint; with CF SSL set to "Full" (not Full-strict) it accepts
	# this cert without validation and encrypts the CF↔origin hop.
	# If/when we want Full-strict, swap for a Cloudflare Origin CA cert.
	tls internal

	# Upstream timeouts cover two distinct long operations:
	#   - Individual chunk POSTs from slow client connections (rare for
	#     local gigabit clients, common on 4G/5G). A 50 MB chunk at
	#     2 Mbps is ~3 min.
	#   - The /status polling endpoint itself is always fast (<100 ms).
	# The old /complete synchronous path could run 10-20 min; that work
	# is now in the upload-completion queue, so /complete returns in
	# under 10 s. 30 min is plenty of headroom.
	# Static IP from docker-compose.yml's `montr` bridge network. Using the
	# IP directly avoids Docker's embedded DNS (127.0.0.11), which
	# periodically returns "server misbehaving" and produced random 502s
	# + torn-down WebSockets until we switched to IP.
	reverse_proxy 172.28.0.10:3000 {
		transport http {
			read_timeout 30m
			write_timeout 30m
			dial_timeout 10s
		}
	}

	# WebSocket handshake is already handled transparently by reverse_proxy.
}
