{
  "name": "montr-integration-tests",
  "version": "1.0.0",
  "description": "End-to-end integration tests for Montr system",
  "private": true,
  "scripts": {
    "test": "jest",
    "test:e2e": "jest --testPathPattern=e2e",
    "test:watch": "jest --watch",
    "test:verbose": "jest --verbose",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --runInBand"
  },
  "keywords": [
    "integration-tests",
    "e2e",
    "montr"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "axios": "^1.6.0",
    "form-data": "^4.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0",
    "uuid": "^9.0.0",
    "@types/uuid": "^9.0.0"
  }
}
