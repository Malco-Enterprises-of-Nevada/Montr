# Project-wide ignores

# Environment files
.env
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Node modules (root + server)
node_modules/
server/node_modules/
server/dist/
server/build/
server/.env
server/storage/*
!server/storage/.gitkeep
server/data/
server/*.db
server/*.db-journal

# Client (Rust)
client/target/
client/Cargo.lock
client/**/*.rs.bk
client/.cargo/
client/config.toml

# Test coverage
coverage/
*.lcov

# Temporary files
*.tmp
*.temp
temp/

# Build artifacts
*.deb
*.rpm
*.msi
*.exe
*.tar.gz
*.zip

# Package outputs
scripts/packaging/**/output/
scripts/packaging/**/build/

# Media files (local testing)
test-media/*
uploads/*
