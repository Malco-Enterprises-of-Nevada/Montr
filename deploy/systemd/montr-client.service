[Unit]
Description=Montr Media Client
Documentation=https://github.com/montr/montr
After=network-online.target graphical-session.target
Wants=network-online.target

[Service]
Type=simple
# User, Group, and display environment (DISPLAY / WAYLAND_DISPLAY /
# XDG_RUNTIME_DIR / XAUTHORITY) are written by the postinst into
# /etc/systemd/system/montr-client.service.d/00-kiosk-user.conf based on
# the auto-login user detected at install time. Operators who want a
# different user can drop in /etc/systemd/system/montr-client.service.d/
# override.conf — its later sort order overrides the postinst defaults.
ExecStart=/usr/bin/montr-client --config /etc/montr-client/config.toml
Restart=on-failure
RestartSec=10
TimeoutStopSec=10

# Security hardening
ProtectSystem=strict
NoNewPrivileges=true
ReadWritePaths=/var/cache/montr-client /var/log/montr-client

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=montr-client

[Install]
WantedBy=multi-user.target
