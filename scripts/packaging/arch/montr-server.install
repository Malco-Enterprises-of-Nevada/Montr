post_install() {
    # Create system user if it doesn't exist
    if ! id -u montr >/dev/null 2>&1; then
        useradd --system --create-home --shell /usr/sbin/nologin montr
    fi

    # Set ownership
    chown -R montr:montr /opt/montr-server
    chown -R montr:montr /etc/montr-server

    # Enable service
    systemctl daemon-reload
    systemctl enable montr-server.service

    echo "==> Configure the server: /etc/montr-server/montr-server.env"
    echo "==> Then start: systemctl start montr-server"
}

post_upgrade() {
    systemctl daemon-reload
    # Restart if already running
    if systemctl is-active --quiet montr-server.service; then
        systemctl try-restart montr-server.service
    fi
}

pre_remove() {
    # Stop service if running
    if systemctl is-active --quiet montr-server.service; then
        systemctl stop montr-server.service
    fi
}

post_remove() {
    systemctl disable montr-server.service 2>/dev/null || true
    systemctl daemon-reload

    echo "==> Data directories preserved: /opt/montr-server/{data,storage,logs}"
    echo "==> To fully remove: rm -rf /opt/montr-server /etc/montr-server"
    echo "==> To remove the montr user: userdel montr"
}
