#!/bin/bash
set -e

case "$1" in
    remove)
        systemctl disable montr-client.service 2>/dev/null || true
        systemctl disable montr-client-updater.path 2>/dev/null || true
        systemctl disable montr-client-updater.service 2>/dev/null || true
        systemctl daemon-reload
        ;;
    purge)
        rm -rf /etc/montr-client
        rm -rf /var/cache/montr-client /var/log/montr-client
        rm -rf /usr/lib/montr-client
        # Drop-ins written by postinst (00-kiosk-user.conf or
        # 00-system-user.conf). Leave any operator-written override.conf alone.
        rm -f /etc/systemd/system/montr-client.service.d/00-kiosk-user.conf
        rm -f /etc/systemd/system/montr-client.service.d/00-system-user.conf
        rmdir --ignore-fail-on-non-empty /etc/systemd/system/montr-client.service.d 2>/dev/null || true
        if id -u montr >/dev/null 2>&1; then
            userdel montr 2>/dev/null || true
        fi
        systemctl daemon-reload
        ;;
esac

exit 0
