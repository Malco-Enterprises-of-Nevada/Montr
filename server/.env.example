# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./data/montr.db

# MySQL Configuration (if using MySQL)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=montr
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=montr

# MSSQL Configuration (if using MS SQL Server)
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_DATABASE=montr

# MongoDB Configuration (if using MongoDB)
# MONGO_URI=mongodb://localhost:27017/montr

# Storage Configuration
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=500

# Security
API_KEY_REQUIRED=false
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=5000
WS_HEALTH_CHECK_INTERVAL=30000
WS_STALE_TIMEOUT=300000

# UI Configuration
UI_DASHBOARD_REFRESH_MS=30000
UI_TOAST_DURATION_MS=3000
