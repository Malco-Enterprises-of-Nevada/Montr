# Server Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration
DB_TYPE=sqlite
DB_PATH=./data/montr.db

# MySQL Configuration (if using MySQL)
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=montr
# MYSQL_PASSWORD=your_password
# MYSQL_DATABASE=montr

# MSSQL Configuration (if using MS SQL Server)
# MSSQL_SERVER=localhost
# MSSQL_PORT=1433
# MSSQL_USER=sa
# MSSQL_PASSWORD=your_password
# MSSQL_DATABASE=montr

# MongoDB Configuration (if using MongoDB)
# MONGO_URI=mongodb://localhost:27017/montr

# Storage Configuration
STORAGE_BACKEND=local
STORAGE_PATH=./storage
MAX_UPLOAD_SIZE_MB=2048
CHUNK_SIZE_MB=50

# DigitalOcean Spaces (S3-compatible) — only when STORAGE_BACKEND=spaces
# SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
# SPACES_REGION=sfo3
# SPACES_BUCKET=montr-media
# SPACES_ACCESS_KEY_ID=your-access-key
# SPACES_SECRET_ACCESS_KEY=your-secret-key
# SPACES_CDN_ENDPOINT=https://montr-media.sfo3.cdn.digitaloceanspaces.com

# Security
API_KEY_REQUIRED=false
API_KEY=
ALLOWED_ORIGINS=http://localhost:3000

# Logging
LOG_LEVEL=info
LOG_FILE=./logs/server.log

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=5000
WS_HEALTH_CHECK_INTERVAL=30000
WS_STALE_TIMEOUT=300000

# UI Configuration
UI_DASHBOARD_REFRESH_MS=30000
UI_TOAST_DURATION_MS=3000

# TLS/HTTPS
TLS_ENABLED=false
# TLS_CERT_PATH=/etc/ssl/certs/montr.crt
# TLS_KEY_PATH=/etc/ssl/private/montr.key
# TLS_HTTP_PORT=80

# Clustering
CLUSTER_ENABLED=false
# CLUSTER_NODE_ID=node-1
# CLUSTER_DISCOVERY_URL=http://discovery:8500
# CLUSTER_REDIS_URL=redis://localhost:6379

# JWT Authentication
# JWT_SECRET=change-this-to-a-random-secret
# JWT_EXPIRY=24h

# SMTP (for email notifications)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=notifications@example.com
# SMTP_PASS=your-password
# SMTP_FROM=noreply@example.com

# Content approval — when true, only approval_status='approved' media can be added to playlists
REQUIRE_MEDIA_APPROVAL=false
