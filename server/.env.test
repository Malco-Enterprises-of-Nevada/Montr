# Test Environment Configuration
NODE_ENV=test
PORT=3001
HOST=localhost

# Database
DB_TYPE=sqlite
DB_PATH=:memory:

# Storage
STORAGE_PATH=./test-storage
MAX_UPLOAD_SIZE_MB=500

# Logging - Set to error to reduce test noise
LOG_LEVEL=error
LOG_FILE=

# WebSocket
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=5000
